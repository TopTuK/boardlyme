# Native (non-Docker) backend development defaults.
# Copy to backend/.env — pydantic-settings reads it from the backend/ cwd.
# Container deployments override these via docker-compose environment.

# Local Postgres — start one with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgresql+asyncpg://boardly:boardly@localhost:5432/boardly

# Any random string for local development.
JWT_SECRET=dev-secret-change-me

# 1 = enable the Alice/Bob dev login on /login (no Telegram needed).
DEV_FAKE_AUTH=1

# Fill these in to test real Telegram auth/mini app/reminders locally,
# together with an HTTPS tunnel (see README → "Testing the Telegram flows").
BOT_TOKEN=
BOT_USERNAME=

# Reminder scheduler (only active when BOT_TOKEN is set).
REMINDERS_ENABLED=1
REMINDERS_DAILY_TIME=09:00
REMINDERS_DEADLINE_DAYS=2
REMINDERS_CHECK_INTERVAL_MIN=30
REMINDERS_TIMEZONE=UTC
