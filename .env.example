# Boardly environment
# Copy to `.env` next to docker-compose.yml and adjust as needed.

# Telegram bot created via @BotFather.
# Required for real auth (Login Widget + Mini App). Leave empty for dev mode.
BOT_TOKEN=
BOT_USERNAME=

# Public URL of the site. In production it must be an HTTPS domain that was
# registered in BotFather (via /setdomain) — the Login Widget only works there.
APP_URL=http://localhost:8080

# Hostname the shared VPS reverse proxy routes to this stack (nginx-proxy
# VIRTUAL_HOST on the external network pmi_network). Required by
# docker-compose.production.yml. Must be the host of APP_URL.
# VIRTUAL_HOST=boardly.example.com

# Secret used to sign JWTs. Change it in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me

# 1 = enable dev login without Telegram (buttons "Alice"/"Bob" on the login page).
# Production compose forces this off. Set to 1 only for local fake login.
DEV_FAKE_AUTH=1

# Host port for local `docker compose up`. The production compose file does
# not publish a host port; the proxy reaches the frontend on port 80.
APP_PORT=8080

# --- Telegram reminders (daily digest of active tasks + deadlines) ---
# The digest is sent once per day per user at the given local time.
REMINDERS_ENABLED=1
REMINDERS_DAILY_TIME=09:00
# Remind this many days before a deadline (overdue tasks are always included).
REMINDERS_DEADLINE_DAYS=2
# How often the scheduler wakes up to check whether it is time to send.
REMINDERS_CHECK_INTERVAL_MIN=30
# IANA timezone for the daily time, e.g. Europe/Berlin.
REMINDERS_TIMEZONE=UTC
